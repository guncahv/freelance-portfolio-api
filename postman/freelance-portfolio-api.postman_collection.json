  "info": {
    "_postman_id": "50d6578d-bfec-4515-8589-c246abffb4c7",
    "name": "Freelance Portfolio API — ЛР №28",
    "description": "CRUD-запросы к /api/projects (Express + MongoDB). Запросы выполняются по порядку: POST сохраняет ID проекта в переменную projectId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST — создать проект",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "description": "Создание новой сущности. ID созданного проекта сохраняется в переменную {{projectId}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Маркетплейс handmade-товаров\",\n  \"description\": \"Каталог, корзина и кабинет мастера. Загрузка страниц стала быстрее на 40 %.\",\n  \"imageUrl\": \"/assets/project-marketplace.svg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201 Created', () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.test('Ответ содержит _id и title', () => { pm.expect(p).to.have.property('_id'); pm.expect(p.title).to.eql('Маркетплейс handmade-товаров'); });",
              "pm.collectionVariables.set('projectId', p._id);"
            ]
          }
        }
      ]
    },
